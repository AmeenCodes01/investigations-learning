# Copy to .env and fill in. .env is git-ignored: never commit real passwords.
# Load it, then start the gateway (which starts the toolbox):  source .env && go run ./cmd/gateway
export DATABASE_URL_RO='toolbox_ro:dev-ro@tcp(localhost:3306)/shop'
export DATABASE_URL_RW='toolbox_rw:dev-rw@tcp(localhost:3306)/shop'
